{
    "custom/theme": {
        "exec": "cat ~/Dotfiles/colors/.theme/current/current",
        /* in the scripts we restart waybar, so it is sufficient to only exec on (re-)startup :) */
        "interval": "once",
        "on-click": "~/Dotfiles/waybar/.config/waybar/scripts/switch_theme.sh",
        "tooltip": false
    }
}
